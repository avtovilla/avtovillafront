:root {
    --bg-dark: #0a0c10;        /* Глубокий премиальный темный фон */
    --card-bg: #141822;        /* Контрастный фон для карточек авто */
    --text-main: #ffffff;
    --text-muted: #8e94a0;

    /* ФИРМЕННЫЙ СИНИЙ СТИЛЬ */
    --accent-blue: #0074d9;
    --accent-hover: #0056b3;
    --accent-glow: #00f7ff;    /* Бирюзово-голубой неон для подсветки */
    --gradient-blue: linear-gradient(135deg, #00f7ff 0%, #0074d9 100%);

    --transition-smooth: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
}

body {
    background-color: var(--bg-dark);
    color: var(--text-main);
}

.container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
}

/* --- ШАПКА САЙТА --- */
.main-header {
    background: rgba(10, 12, 16, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    height: 85px;
    display: flex;
    align-items: center;
}

.header-container-fluid {
    width: 100%;
    max-width: 1920px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
}

.logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: var(--transition-smooth);
}
.logo-link:hover {
    transform: scale(1.02);
    opacity: 0.9;
}
.header-logo {
    height: 65px;
    width: auto;
    object-fit: contain;
}

.nav-menu { display: flex; gap: 35px; }
.nav-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: var(--transition-smooth);
    position: relative;
    padding: 5px 0;
}
.nav-link:hover, .nav-link.active { color: #fff; }
.nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--accent-blue);
    transition: var(--transition-smooth);
}
.nav-link:hover::after, .nav-link.active::after { width: 100%; }

.header-contacts { display: flex; align-items: center; gap: 25px; }
.phone-link {
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 16px;
}

/* --- КНОПКИ --- */
button { cursor: pointer; border: none; outline: none; }

.btn-callback {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(0, 247, 255, 0.3);
    padding: 10px 22px;
    border-radius: 4px;
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    transition: var(--transition-smooth);
}
.btn-callback:hover {
    background: var(--gradient-blue);
    color: #000;
    border-color: transparent;
    box-shadow: 0 0 20px rgba(0, 247, 255, 0.5);
}

.btn-primary {
    background: var(--gradient-blue);
    color: #fff;
    padding: 16px 38px;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-radius: 4px;
    transition: var(--transition-smooth);
    box-shadow: 0 4px 15px rgba(0, 116, 217, 0.3);
}
.btn-primary:hover {
    box-shadow: 0 0 25px rgba(0, 247, 255, 0.6);
    transform: translateY(-2px);
}

.btn-secondary {
    background: transparent;
    color: #fff;
    border: 2px solid #fff;
    padding: 14px 36px;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    border-radius: 4px;
    transition: var(--transition-smooth);
}
.btn-secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
}

/* --- ГЛАВНЫЙ БАННЕР С КАРТОЧКАМИ ВНУТРИ --- */
.hero-section {
    min-height: 85vh; /* Монументальная высота сохранена */
    background: linear-gradient(rgba(10, 12, 16, 0.6), rgba(10, 12, 16, 0.6)),
                url('https://images.unsplash.com/photo-1617788138017-80ad40651399?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
    position: relative;
    display: flex;
    align-items: center;
    padding: 120px 0 60px 0;
}
.hero-overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(to right, rgba(10, 12, 16, 0.98) 40%, rgba(10, 12, 16, 0.5) 100%);
    z-index: 1;
}

.hero-container-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1700px;
    margin: 0 auto;
    padding: 0 50px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 50px;
}

.hero-text-block {
    flex: 1;
    max-width: 650px;
}
.hero-badge {
    color: var(--accent-glow);
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    display: inline-block;
    margin-bottom: 15px;
}
.hero-title {
    font-size: 54px;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 22px;
}
.hero-subtitle {
    font-size: 18px;
    color: #cbd5e1;
    margin-bottom: 35px;
}
.hero-buttons { display: flex; gap: 20px; }

/* ПРАВАЯ СТОРОНА: СЕТКА ДЛЯ ВОЗВРАЩЕННЫХ СПЕЦПРЕДЛОЖЕНИЙ */
.hero-offers-side {
    flex: 1;
    max-width: 600px;
}
.mini-offers-grid {
    display: flex;
    flex-direction: column;
    gap: 25px;
}

/* Стиль карточки спецпредложения */
.promo-card {
    background: rgba(20, 24, 34, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 25px;
    position: relative;
    transition: var(--transition-smooth);
}
.promo-card:hover {
    transform: translateX(-5px);
    border-color: rgba(0, 247, 255, 0.3);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5), 0 0 20px rgba(0, 247, 255, 0.1);
}

.promo-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    background: rgba(0, 116, 217, 0.2);
    border: 1px solid var(--accent-blue);
    color: #00f7ff;
    padding: 5px 12px;
    font-size: 11px;
    font-weight: 700;
    border-radius: 20px;
    text-transform: uppercase;
}
.promo-badge.hot {
    background: linear-gradient(135deg, #ff0844 0%, #ffb199 100%);
    border: none;
    color: #fff;
}

.promo-card-info h3 {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 8px;
}
.promo-card-info p {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 20px;
    max-width: 80%;
}

.promo-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 15px;
}
.promo-prices {
    display: flex;
    flex-direction: column;
}
.old-price {
    font-size: 12px;
    color: #64748b;
    text-decoration: line-through;
    margin-bottom: 2px;
}
.new-price {
    font-size: 20px;
    font-weight: 800;
    color: var(--accent-glow);
}

.btn-promo-action {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 8px 16px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    border-radius: 4px;
    transition: var(--transition-smooth);
}
.promo-card:hover .btn-promo-action {
    background: var(--gradient-blue);
    color: #000;
    border-color: transparent;
}

/* --- СЕКЦИЯ КАТАЛОГА --- */
.catalog-section { padding: 80px 0; background-color: var(--bg-dark); }
.catalog-header { text-align: center; margin-bottom: 60px; }
.section-title { font-size: 36px; font-weight: 800; margin-bottom: 12px; }
.section-desc { color: var(--text-muted); font-size: 16px; }

.cars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 35px;
}

.car-card {
    background: var(--card-bg);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(255, 255, 255, 0.02);
    transition: var(--transition-smooth);
    cursor: pointer;
}
.car-card:hover {
    transform: translateY(-8px);
    border-color: rgba(0, 247, 255, 0.2);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6);
}

.car-image-container {
    width: 100%;
    height: 230px;
    background: #0f121a;
    overflow: hidden;
    position: relative;
}
.car-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.car-card:hover .car-image {
    transform: scale(1.05);
}

.car-info { padding: 25px; flex-grow: 1; display: flex; flex-direction: column; }
.car-title { font-size: 24px; font-weight: 700; margin-bottom: 15px; color: #fff; }

.price-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 12px;
}
.price-label { font-size: 14px; color: var(--text-muted); }
.base-price { font-size: 24px; font-weight: 800; color: #fff; }

.monthly-block {
    background: rgba(255, 255, 255, 0.02);
    border-left: 3px solid var(--accent-blue);
    padding: 12px 15px;
    margin-bottom: 22px;
    border-radius: 0 4px 4px 0;
}
.monthly-label { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
.monthly-price { font-size: 17px; font-weight: 700; color: #fff; margin-top: 2px; }

.btn-card-action {
    background: transparent;
    color: var(--text-main);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 13px 0;
    width: 100%;
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-radius: 4px;
    text-align: center;
    margin-top: auto;
    transition: var(--transition-smooth);
}
.car-card:hover .btn-card-action {
    background: var(--gradient-blue);
    color: #000;
    border-color: transparent;
    box-shadow: 0 5px 15px rgba(0, 247, 255, 0.3);
}

/* ЗАГРУЗКА */
.loading-spinner { grid-column: 1 / -1; text-align: center; padding: 60px 0; }
.spinner {
    width: 40px; height: 40px; border: 3px solid rgba(255, 255, 255, 0.05);
    border-top: 3px solid var(--accent-blue); border-radius: 50%;
    margin: 0 auto 15px; animation: spin 1s linear infinite;
}
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

.main-footer { background: #050608; padding: 35px 0; border-top: 1px solid rgba(255, 255, 255, 0.05); text-align: center; color: var(--text-muted); font-size: 13px; }

/* АДАПТИВНОСТЬ К СМАРТФОНАМ */
@media (max-width: 1024px) {
    .hero-container-content {
        flex-direction: column;
        padding: 0 20px;
    }
    .hero-text-block, .hero-offers-side {
        max-width: 100%;
        width: 100%;
    }
}